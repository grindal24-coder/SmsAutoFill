<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Прозрачный "попап" с предложением вставить код. Запускается
             из SmsReceiver даже когда приложение полностью закрыто. -->
        <activity
            android:name=".CodePopupActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Dialog.Alert"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- Манифест-ресивер: получает SMS даже когда процесс приложения
             не запущен. Работает без Google Play Services. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
